#!/bin/sh
# Blockiert direkte Pushes auf main. Änderungen kommen nur per Pull Request nach main.
# Aktivieren (einmal pro Klon): git config core.hooksPath .githooks

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "Push auf 'main' blockiert."
    echo "Bitte auf einem Feature-Branch arbeiten und einen Pull Request erstellen:"
    echo "  git checkout -b <name>/<aufgabe>"
    echo ""
    exit 1
  fi
done

exit 0
